<Window x:Class="NRLiveUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="NRLive" Width="1000" Height="720" MinWidth="900" MinHeight="640"
        WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI Variable Text, Segoe UI"
        Loaded="Window_Loaded" Closing="Window_Closing"
        Icon="img/Icon.png">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Grid Margin="0">
        <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Background="#17191D">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <Image Source="img/Icon.png" Width="20" Height="20" VerticalAlignment="Center"/>
                <TextBlock Text="NRLive" FontSize="12" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center"/>
                <TextBlock Text="WINDOW SCALER" FontSize="9" Foreground="{StaticResource MutedBrush}" Margin="8,1,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Stretch">
                <Button Content="—" Width="44" Padding="0" Background="Transparent" BorderThickness="0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Minimize_Click"/>
                <Button x:Name="MaximizeButton" Content="□" Width="44" Padding="0" Background="Transparent" BorderThickness="0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Maximize_Click"/>
                <Button Content="×" Width="44" Padding="0" Background="Transparent" BorderThickness="0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1" Margin="18">
        <Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#1C1F24" CornerRadius="14" Padding="14">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="4,5,0,22">
                        <Image Source="img/Icon.png" Width="34" Height="34" VerticalAlignment="Center"/>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="NRLive" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="WINDOW SCALER" FontSize="9" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="PROFILES" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="SemiBold" Margin="4,0,0,8"/>
                    <ComboBox x:Name="ProfileBox" SelectionChanged="ProfileBox_SelectionChanged" Margin="0,0,0,8"/>
                    <Button Content="Save profile" Click="SaveProfile_Click" HorizontalAlignment="Stretch"/>
                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,20,0,18"/>
                    <TextBlock Text="QUICK START" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="SemiBold" Margin="4,0,0,10"/>
                    <TextBlock Text="1. Choose the target window." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="4,0,0,8"/>
                    <TextBlock Text="2. Press Scale and switch to your game during the countdown." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="4,0,0,8"/>
                    <TextBlock Text="3. Press Unscale or the toggle hotkey to stop." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="4,0,0,8"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="2,14,2,2">
                    <Border Background="#25282E" CornerRadius="10" Padding="11">
                        <StackPanel>
                            <TextBlock Text="GLOBAL TOGGLE" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock x:Name="SidebarHotkey" Text="Ctrl + Alt + S" FontSize="14" FontWeight="SemiBold" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="NRLive • Windows 11" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="4,13,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Column="2">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="2,0,0,18">
                <StackPanel>
                    <TextBlock x:Name="ProfileTitle" Text="Scaling setup" FontSize="26" FontWeight="SemiBold"/>
                    <TextBlock Text="Capture a window and configure the scaling session. Sharpening lives in the in-game overlay settings." Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="SCALING SESSION" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="SemiBold"/>
                                <TextBlock Text="Ready when you are" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,4"/>
                                <TextBlock x:Name="StatusText" Text="Press Scale, then switch to the game before the countdown ends." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" MaxWidth="470"/>
                            </StackPanel>
                            <CheckBox x:Name="RunAsAdminCheckBox" Grid.Column="1" Content="Run as admin" IsChecked="True" VerticalAlignment="Center" HorizontalAlignment="Center" ToolTip="Might be necessary for some games with anti cheat" Margin="8,0"/>
                            <Button x:Name="ScaleButton" Grid.Column="2" Content="Scale  →" Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" Foreground="#17131C" FontWeight="SemiBold" FontSize="15" Padding="18,14" VerticalAlignment="Center" Click="ScaleButton_Click"/>
                        </Grid>
                    </Border>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Target window" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14"/>
                                    <TextBlock Text="Capture mode" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="TargetModeBox" SelectedIndex="0" Margin="0,0,0,12">
                                        <ComboBoxItem Content="Picker countdown"/>
                                        <ComboBoxItem Content="Foreground window"/>
                                        <ComboBoxItem Content="Process ID"/>
                                        <ComboBoxItem Content="Process name / regex"/>
                                        <ComboBoxItem Content="Window title / regex"/>
                                    </ComboBox>
                                    <TextBlock Text="PID / process regex / window title" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,5"/>
                                    <TextBox x:Name="TargetTextBox" Text="" ToolTip="Used for PID, process name, or window title modes" Margin="0,0,0,12"/>
                                    <TextBlock Text="Capture source" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="CaptureModeBox" SelectedIndex="0" Margin="0,0,0,12" ToolTip="Choose between Windows Graphics Capture and DXGI Desktop Duplication with window-region cropping">
                                        <ComboBoxItem Content="WGC Window (default)"/>
                                        <ComboBoxItem Content="DXGI Window"/>
                                    </ComboBox>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Countdown (seconds)" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,5"/>
                                            <TextBox x:Name="DelayBox" Text="5"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="HUD" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,5"/>
                                            <CheckBox x:Name="HudCheckBox" Content="Enabled" IsChecked="True" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="Motion vectors" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                    <TextBlock Text="FastMV is the default low-overhead path. AMDOF remains available." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,12"/>
                                    <ComboBox x:Name="MotionBox" SelectedIndex="0">
                                        <ComboBoxItem Content="FastMV (default)"/>
                                        <ComboBoxItem Content="AMDOF optical flow"/>
                                    </ComboBox>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="Upscaler" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                    <TextBlock Text="Runs after DLSSNR. FSR 4 needs an RX 9000; when a provider is not offered, the FSR loader's default is used." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,12"/>
                                    <ComboBox x:Name="UpscalerBox" SelectedIndex="0">
                                        <ComboBoxItem Content="FSR 4 (default)"/>
                                        <ComboBoxItem Content="FSR 3.1"/>
                                        <ComboBoxItem Content="None (native scaling)"/>
                                    </ComboBox>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="Performance HUD" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                    <TextBlock Text="FPS, frametime graph, 1% lows, GPU / CPU sensors and FSR / NR / FG state over the output. Shift+F12 toggles it in game." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,12"/>
                                    <Button Content="HUD settings…" Click="HudSettings_Click" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Hotkeys" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                    <TextBlock Text="Scale / Unscale toggle" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,5"/>
                                    <TextBox x:Name="ScaleHotkeyBox" Text="ctrl+alt+s" IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown" ToolTip="Click then press the key combination to register" Margin="0,0,0,10"/>
                                    <TextBlock Text="Force stop key" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,5"/>
                                    <TextBox x:Name="StopHotkeyBox" Text="ctrl+shift+a" IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown" ToolTip="Click then press the key combination to register" Margin="0,0,0,10"/>
                                    <TextBlock Text="Overlay toggle key" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,5"/>
                                    <TextBox x:Name="OverlayHotkeyBox" Text="ctrl+home" IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown" ToolTip="Click then press the key combination to register"/>
                                    <TextBlock Text="Passthrough keys (comma-separated)" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,10,0,5"/>
                                    <TextBox x:Name="BindBypassBox" Text="home,insert,end,pageup,pagedown" ToolTip="Keys sent to OptiScaler/ReShade instead of the game. Supports Space and modifiers, e.g. ctrl+space."/>
                                    <TextBlock Text="Hotkeys must not conflict. Passthrough keys are sent to OptiScaler / ReShade." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="Executable" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                    <TextBox x:Name="ExePathBox" Text="NRLive.exe" Margin="0,0,0,8"/>
                                    <Button Content="Browse for NRLive.exe…" Click="BrowseExe_Click" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,14,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,5">
                                <TextBlock Text="DLSSNR" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <CheckBox x:Name="NrEnabledBox" Content="Enabled at start" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="The NR button in the overlay turns it on and off while NRLive runs"/>
                            </Grid>
                            <TextBlock x:Name="NrRuntimeStatus" Text="" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,12"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Runtime" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="NrRuntimeBox" SelectedIndex="0" Margin="0,0,0,10">
                                        <ComboBoxItem Content="Auto (OpenNR when installed)"/>
                                        <ComboBoxItem Content="OpenNR runtime"/>
                                        <ComboBoxItem Content="DLSSNR-AMD 0.0.6 bridge"/>
                                    </ComboBox>
                                    <TextBlock Text="Model" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="NrModelBox" SelectedIndex="0" Margin="0,0,0,10" ToolTip="Small needs dlssnr-amd\dlssnr-small.bin; Original needs dlssnr-amd\dlssnr.bin. A change rebuilds the network.">
                                        <ComboBoxItem Content="Small 310.9.16 (faster)"/>
                                        <ComboBoxItem Content="Original 310.8"/>
                                    </ComboBox>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Style" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,5"/>
                                            <ComboBox x:Name="NrStyleBox" SelectedIndex="0">
                                                <ComboBoxItem Content="Standard"/>
                                                <ComboBoxItem Content="Natural"/>
                                                <ComboBoxItem Content="Cinematic"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Passes" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,5"/>
                                            <ComboBox x:Name="NrPassesBox" SelectedIndex="0" ToolTip="Each pass adds the network's whole cost. A change rebuilds the network.">
                                                <ComboBoxItem Content="1"/>
                                                <ComboBoxItem Content="2"/>
                                                <ComboBoxItem Content="3"/>
                                                <ComboBoxItem Content="4"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                    <CheckBox x:Name="NrStyleGradeBox" Content="Style grade (Natural / Cinematic)" Margin="0,2,0,6" ToolTip="Grades Natural and Cinematic after the network, as NVIDIA's DLL does"/>
                                    <CheckBox x:Name="NrAutoMaskBox" Content="Auto mask (skin keeps its own structure)" Margin="0,0,0,6"/>
                                    <CheckBox x:Name="NrTemporalBox" Content="Temporal history (NRLive motion vectors)" Margin="0,0,0,6"/>
                                    <CheckBox x:Name="NrAcoBox" Content="ACO machine code (restart NRLive to change)" Margin="0,0,0,6"/>
                                    <CheckBox x:Name="NrInt4Box" Content="int4 mixed (Original model, ACO, dlssnr-int4.bin)" ToolTip="Faster, the picture slightly different. Needs dlssnr-amd\dlssnr-int4.bin from an OpenNR install."/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <Grid Margin="0,0,0,2"><TextBlock Text="Intensity" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock Text="{Binding Value, ElementName=NrIntensitySlider, StringFormat={}{0:0.00}}" HorizontalAlignment="Right" FontSize="11"/></Grid>
                                    <Slider x:Name="NrIntensitySlider" Minimum="0" Maximum="2" Value="1" SmallChange="0.05" LargeChange="0.25" Margin="0,0,0,10"/>
                                    <Grid Margin="0,0,0,2"><TextBlock Text="Local tone" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock Text="{Binding Value, ElementName=NrLocalToneSlider, StringFormat={}{0:0.00}}" HorizontalAlignment="Right" FontSize="11"/></Grid>
                                    <Slider x:Name="NrLocalToneSlider" Minimum="0" Maximum="2" Value="1" SmallChange="0.05" LargeChange="0.25" Margin="0,0,0,10"/>
                                    <Grid Margin="0,0,0,2"><TextBlock Text="Local structure" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock Text="{Binding Value, ElementName=NrStructureSlider, StringFormat={}{0:0.00}}" HorizontalAlignment="Right" FontSize="11"/></Grid>
                                    <Slider x:Name="NrStructureSlider" Minimum="0" Maximum="2" Value="1" SmallChange="0.05" LargeChange="0.25" Margin="0,0,0,10"/>
                                    <Grid Margin="0,0,0,2"><TextBlock Text="Skin structure (-1 = model's own)" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock Text="{Binding Value, ElementName=NrSkinSlider, StringFormat={}{0:0.00}}" HorizontalAlignment="Right" FontSize="11"/></Grid>
                                    <Slider x:Name="NrSkinSlider" Minimum="-1" Maximum="1" Value="-1" SmallChange="0.05" LargeChange="0.25" Margin="0,0,0,10"/>
                                    <Grid Margin="0,0,0,2"><TextBlock Text="Colour strength" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock Text="{Binding Value, ElementName=NrColourSlider, StringFormat={}{0:0.00}}" HorizontalAlignment="Right" FontSize="11"/></Grid>
                                    <Slider x:Name="NrColourSlider" Minimum="0" Maximum="1" Value="1" SmallChange="0.05" LargeChange="0.25" Margin="0,0,0,10"/>
                                    <Grid Margin="0,0,0,2"><TextBlock Text="History strength" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock Text="{Binding Value, ElementName=NrHistorySlider, StringFormat={}{0:0.00}}" HorizontalAlignment="Right" FontSize="11"/></Grid>
                                    <Slider x:Name="NrHistorySlider" Minimum="0" Maximum="1" Value="1" SmallChange="0.05" LargeChange="0.25"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="The OpenNR settings apply live while NRLive runs. They are saved in scaleconfig.ini [OpenNR] under OptiScaler's Mochizuki* key names; the other RenoDX keys can be added there by hand. The 0.0.6 bridge keeps its own settings in the overlay." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#1B1E23" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,14,0,0">
                        <TextBlock x:Name="CommandPreview" Text="NRLive.exe --mv fast" FontFamily="Cascadia Code, Consolas" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <Grid Grid.Row="2" Margin="2,14,2,0">
                <TextBlock x:Name="FooterStatus" Text="Ready" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="VersionText" Text="v2.1.0" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button x:Name="CheckUpdatesButton" Content="Check for updates" Click="CheckForUpdates_Click" Padding="10,5" Margin="0,0,14,0"/>
                    <TextBlock Text="FSR SDK 2.3.0 • DX12" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>
        </Grid>
    </Grid>
</Window>

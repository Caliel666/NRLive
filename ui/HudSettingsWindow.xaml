<Window x:Class="NRLiveUI.HudSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Performance HUD" Width="640" Height="760" MinHeight="520"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" ShowInTaskbar="False">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Background="#17191D">
            <TextBlock Text="Performance HUD" FontSize="12" FontWeight="SemiBold" Margin="16,0,0,0" VerticalAlignment="Center"/>
            <Button Content="×" Width="44" Padding="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click"/>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,16,18,0">
            <StackPanel>
                <TextBlock Text="MangoHud-style overlay drawn on NRLive's output window. Changes are written to scaleconfig.ini next to NRLive.exe and a running NRLive picks them up within a second."
                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="12" Margin="2,0,0,14"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Preset" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <UniformGrid Columns="4">
                            <Button x:Name="PresetMinimal" Content="Minimal" Margin="0,0,6,0" Click="Preset_Click" Tag="1" ToolTip="FPS only"/>
                            <Button x:Name="PresetCompact" Content="Compact" Margin="3,0,3,0" Click="Preset_Click" Tag="2" ToolTip="One horizontal line: FPS, frametime, GPU, CPU, FSR/NR/FG"/>
                            <Button x:Name="PresetStandard" Content="Standard" Margin="3,0,3,0" Click="Preset_Click" Tag="3" ToolTip="FPS, lows, frametime graph, GPU, VRAM, CPU, pipeline, resolution"/>
                            <Button x:Name="PresetFull" Content="Full" Margin="6,0,0,0" Click="Preset_Click" Tag="4" ToolTip="Everything, including GPU pass times, latency, RAM and clock"/>
                        </UniformGrid>
                        <TextBlock x:Name="PresetHint" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Items" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <WrapPanel x:Name="ItemsPanel"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Layout" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Orientation" Style="{StaticResource Caption}"/>
                                <ComboBox x:Name="LayoutBox">
                                    <ComboBoxItem Content="Vertical"/>
                                    <ComboBoxItem Content="Horizontal"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Position" Style="{StaticResource Caption}"/>
                                <ComboBox x:Name="PositionBox">
                                    <ComboBoxItem Content="Top left"/>
                                    <ComboBoxItem Content="Top right"/>
                                    <ComboBoxItem Content="Bottom left"/>
                                    <ComboBoxItem Content="Bottom right"/>
                                    <ComboBoxItem Content="Top centre"/>
                                    <ComboBoxItem Content="Bottom centre"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,4">
                            <CheckBox x:Name="BackgroundBox" Content="Background" Margin="0,0,24,0"/>
                            <CheckBox x:Name="OutlineBox" Content="Text shadow"/>
                        </StackPanel>
                        <Grid x:Name="SliderGrid" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Colours and hotkeys" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <UniformGrid Columns="3">
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Accent" Style="{StaticResource Caption}"/>
                                <DockPanel>
                                    <Border x:Name="AccentSwatch" DockPanel.Dock="Left" Width="22" Height="22" CornerRadius="5" Margin="0,0,8,0"/>
                                    <TextBox x:Name="AccentBox" Text="#ED1C24"/>
                                </DockPanel>
                            </StackPanel>
                            <StackPanel Margin="4,0,4,0">
                                <TextBlock Text="Text" Style="{StaticResource Caption}"/>
                                <DockPanel>
                                    <Border x:Name="TextSwatch" DockPanel.Dock="Left" Width="22" Height="22" CornerRadius="5" Margin="0,0,8,0"/>
                                    <TextBox x:Name="TextColorBox" Text="#F0F0F2"/>
                                </DockPanel>
                            </StackPanel>
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Text="Graph" Style="{StaticResource Caption}"/>
                                <DockPanel>
                                    <Border x:Name="GraphSwatch" DockPanel.Dock="Left" Width="22" Height="22" CornerRadius="5" Margin="0,0,8,0"/>
                                    <TextBox x:Name="GraphColorBox" Text="#ED1C24"/>
                                </DockPanel>
                            </StackPanel>
                        </UniformGrid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Toggle HUD" Style="{StaticResource Caption}"/>
                                <TextBox x:Name="ToggleKeyBox" IsReadOnly="True" PreviewKeyDown="KeyBox_PreviewKeyDown" ToolTip="Click, then press the key combination"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Next preset" Style="{StaticResource Caption}"/>
                                <TextBox x:Name="PresetKeyBox" IsReadOnly="True" PreviewKeyDown="KeyBox_PreviewKeyDown" ToolTip="Click, then press the key combination"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="The overlay key (Ctrl+Home by default) still opens the NRLive menu; its FPS button also toggles the HUD." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="2" Margin="18,10,18,14">
            <TextBlock x:Name="StatusLine" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,200,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <CheckBox x:Name="EnabledBox" Content="HUD enabled" Margin="0,0,14,0"/>
                <Button Content="Save" Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" Foreground="#17131C" FontWeight="SemiBold" Padding="20,8" Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
